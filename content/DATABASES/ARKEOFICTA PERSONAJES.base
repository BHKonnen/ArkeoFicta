filters:
  and:
    - file.ext == "md"
    - file.hasProperty("character_type")
properties:
  publish:
    displayName: Publicado
  file.name:
    displayName: Personaje
  character_type:
    displayName: Tipo
  estado_vital:
    displayName: Estado vital
  campana:
    displayName: Campaña
  related_groups:
    displayName: Grupos
  related_events:
    displayName: Eventos
  related_entries:
    displayName: Entradas
views:
  - type: table
    name: Todos
    order:
      - file.name
      - character_type
      - estado_vital
      - campana
      - related_groups
      - related_events
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Publicados
    filters:
      and:
        - publish == true
    order:
      - file.name
      - character_type
      - estado_vital
      - campana
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Por tipo
    groupBy:
      property: character_type
      direction: ASC
    order:
      - file.name
      - character_type
      - estado_vital
      - campana
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Por campaña
    groupBy:
      property: campana
      direction: ASC
    order:
      - file.name
      - campana
      - character_type
      - estado_vital
    sort:
      - property: file.name
        direction: ASC
