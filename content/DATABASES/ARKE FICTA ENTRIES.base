filters:
  and:
    - file.ext == "md"
    - file.hasProperty("topic")
properties:
  publish:
    displayName: Publicado
  file.name:
    displayName: Entrada
  resumen:
    displayName: Resumen
  topic:
    displayName: Tema
  multi_tag:
    displayName: Etiquetas
  campana:
    displayName: Campaña
  acceso:
    displayName: Acceso
views:
  - type: table
    name: Todas las entradas
    order:
      - file.name
      - resumen
      - topic
      - multi_tag
      - campana
      - acceso
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 167
      note.resumen: 248
      note.topic: 107
      note.multi_tag: 155
  - type: table
    name: Publicadas
    filters:
      and:
        - publish == true
    order:
      - file.name
      - resumen
      - topic
      - multi_tag
      - campana
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Públicas
    filters:
      and:
        - acceso == "publico"
    order:
      - file.name
      - resumen
      - topic
      - multi_tag
      - campana
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Por campaña
    groupBy:
      property: campana
      direction: ASC
    order:
      - file.name
      - resumen
      - campana
      - topic
      - multi_tag
      - acceso
